<launch>
  <include file="$(find rm_description_for_task)/launch/hero.launch">
    <arg name="load_chassis" value="true"/>
    <arg name="roller_type" value="simple"/>
    <arg name="paused" value="false"/>
  </include>

  <rosparam file="$(find hero_chassis_controller)/config/controllers.yaml" command="load"/>
  <!-- load the controllers -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
        output="screen" args="
        controller/hero_chassis_controller
        controller/joint_state_controller
  "/>
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find hero_chassis_controller)/rviz/odom_tf.rviz"/>

</launch>
